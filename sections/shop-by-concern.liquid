{% style %}
  .shop-concern__section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .shop-concern__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
  }
  @media only screen and (min-width: 769px) {
    .shop-concern__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }
  .shop-concern__item {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    display: block;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .shop-concern__item:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
  }
  .shop-concern__image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .shop-concern__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .shop-concern__item:hover .shop-concern__image {
    transform: scale(1.05);
  }
  .shop-concern__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,0) 30%, rgba(0,0,0,0.7) 100%);
    pointer-events: none;
    z-index: 1;
  }
  .shop-concern__title {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 15px 10px;
    text-align: center;
    color: #ffffff;
    margin: 0;
    z-index: 2;
    font-weight: 600;
    font-size: 1.1em;
    line-height: 1.3;
    text-shadow: 0 1px 3px rgba(0,0,0,0.4);
  }
  @media only screen and (min-width: 769px) {
    .shop-concern__title {
      font-size: 1.3em;
      padding: 20px 15px;
    }
  }
{% endstyle %}

<div class="shop-concern__section page-width" data-section-id="{{ section.id }}" data-section-type="shop-concern">
  {% if section.settings.title != blank %}
    <div class="section-header text-center">
      <h2 class="h2">{{ section.settings.title }}</h2>
    </div>
  {% endif %}

  <div class="shop-concern__grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link_url | default: '#' }}" class="shop-concern__item" {{ block.shopify_attributes }}>
        <div class="shop-concern__image-wrapper">
          {% if block.settings.image != blank %}
            {%- assign img_url = block.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
            <img class="shop-concern__image lazyload"
                data-src="{{ img_url }}"
                data-widths="[180, 360, 540, 720, 900]"
                data-aspectratio="{{ block.settings.image.aspect_ratio }}"
                data-sizes="auto"
                alt="{{ block.settings.title | escape | default: block.settings.image.alt }}">
            <noscript>
              <img class="shop-concern__image" src="{{ block.settings.image | img_url: '400x400', crop: 'center' }}" alt="{{ block.settings.title | escape | default: block.settings.image.alt }}">
            </noscript>
          {% else %}
            <div class="shop-concern__image" style="display:flex; align-items:center; justify-content:center;">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}
        </div>
        <div class="shop-concern__overlay"></div>
        {% if block.settings.title != blank %}
          <div class="shop-concern__title h3">{{ block.settings.title }}</div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Shop by Concern",
  "class": "index-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Concern"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Acne & Blemishes"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Concern",
      "category": "Collections",
      "blocks": [
        { "type": "concern" },
        { "type": "concern" },
        { "type": "concern" },
        { "type": "concern" }
      ]
    }
  ]
}
{% endschema %}
