{% comment %} Please do not edit this file. It is automatically updated by Judge.me{% endcomment %}

{% if widget_type == 'judgeme_review_widget' %}
<div style='clear:both'></div>
<div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-id='{{ product.id }}' data-product-title='{{ product.title | escape }}' data-product-id='{{ product.id }}' data-auto-install='false'>
  {{ product.metafields.judgeme.widget }}
</div>
{% elsif widget_type == 'judgeme_verification_badge' %}
<div style='clear:both'></div>
<div class='jdgm-widget jdgm-verification-badge' data-id='{{ shop.id }}' data-auto-install='false'>
  {{ shop.metafields.judgeme.verification_badge }}
</div>
{% elsif widget_type == 'judgeme_preview_badge' %}
<div style='clear:both'></div>
<div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-template='{% if concierge_install == true or concierge_install == false %}{{ template }}{% else %}collection{% endif %}' data-auto-install='false'>
  {{ product.metafields.judgeme.badge }}
</div>
{% elsif widget_type == 'judgeme_verified_reviews_count_badge' %}
<div style='clear:both'></div>
<span class='jdgm-widget jdgm-verified-reviews-count-badge' data-id='{{ shop.id }}' data-auto-install='false'>
  {{ shop.metafields.judgeme.verified_reviews_count_badge }}
</span>
{% elsif widget_type == 'judgeme_floating_tab' %}
<section class='jdgm-widget jdgm-revs-tab' role='complementary'>
  {{ shop.metafields.judgeme.reviews_tab }}
</section>
{% endif %}
